{
  "name": "kolraf/test-bundle",
  "description": "",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "test"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/framework-bundle": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Kolraf\\TestBundle\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-symfony": "^2.1"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=512M"
  }
}
